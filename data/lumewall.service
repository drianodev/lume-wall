[Unit]
Description=LumeWall Dynamic Wallpaper Daemon
Documentation=https://github.com/drianodev/lumewall
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/lumewalld
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s

# Limites de recursos para garantir consumo desprezível
CPUQuota=5%
MemoryMax=64M

[Install]
WantedBy=graphical-session.target
